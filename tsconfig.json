{
  "compileOnSave": false,
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "skipLibCheck": true,
    "target": "es2022",
    "strict": true,
    "useDefineForClassFields": false,
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "ngx-quill/config": [
        "./projects/ngx-quill/config/src/public_api.ts"
      ],
      "ngx-quill": [
        "./projects/ngx-quill/src/public_api.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
